{
  "$defs": {
    "Annotation": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "type": {
          "enum": [
            "rule",
            "band",
            "text"
          ],
          "title": "Type",
          "type": "string"
        },
        "x": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X"
        },
        "x_end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X End"
        },
        "y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y"
        },
        "y_end": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y End"
        }
      },
      "required": [
        "type"
      ],
      "title": "Annotation",
      "type": "object"
    },
    "DatasetBinding": {
      "additionalProperties": false,
      "description": "A dataset used by the spec. Snapshot mode pins a version; live follows the latest.",
      "properties": {
        "dataset_id": {
          "format": "uuid",
          "title": "Dataset Id",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/DatasetKind"
        },
        "mode": {
          "enum": [
            "snapshot",
            "live"
          ],
          "title": "Mode",
          "type": "string"
        },
        "schema_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Schema Hash",
          "type": "string"
        },
        "version_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version Id"
        }
      },
      "required": [
        "id",
        "dataset_id",
        "kind",
        "schema_hash",
        "mode"
      ],
      "title": "DatasetBinding",
      "type": "object"
    },
    "DatasetKind": {
      "enum": [
        "test_results",
        "perf_samples",
        "generic"
      ],
      "title": "DatasetKind",
      "type": "string"
    },
    "Encoding": {
      "additionalProperties": false,
      "properties": {
        "color": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "series": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Series"
        },
        "size": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "x": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y"
        }
      },
      "title": "Encoding",
      "type": "object"
    },
    "EqFilter": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "op": {
          "const": "eq",
          "default": "eq",
          "title": "Op",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "field",
        "value"
      ],
      "title": "EqFilter",
      "type": "object"
    },
    "GlobalFilter": {
      "additionalProperties": false,
      "properties": {
        "control": {
          "enum": [
            "multiselect",
            "select",
            "range",
            "date_range"
          ],
          "title": "Control",
          "type": "string"
        },
        "dataset": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset"
        },
        "field": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        }
      },
      "required": [
        "id",
        "field",
        "control"
      ],
      "title": "GlobalFilter",
      "type": "object"
    },
    "InFilter": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "op": {
          "const": "in",
          "default": "in",
          "title": "Op",
          "type": "string"
        },
        "values": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "field",
        "values"
      ],
      "title": "InFilter",
      "type": "object"
    },
    "LastNFilter": {
      "additionalProperties": false,
      "description": "Keep the last ``n`` distinct values of an ordinal field, e.g. the last 7 builds.",
      "properties": {
        "field": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "n": {
          "exclusiveMinimum": 0,
          "title": "N",
          "type": "integer"
        },
        "op": {
          "const": "last_n",
          "default": "last_n",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "field",
        "n"
      ],
      "title": "LastNFilter",
      "type": "object"
    },
    "Layout": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "const": 12,
          "default": 12,
          "title": "Columns",
          "type": "integer"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/LayoutItem"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "title": "Layout",
      "type": "object"
    },
    "LayoutItem": {
      "additionalProperties": false,
      "properties": {
        "h": {
          "maximum": 48,
          "minimum": 1,
          "title": "H",
          "type": "integer"
        },
        "w": {
          "maximum": 12,
          "minimum": 1,
          "title": "W",
          "type": "integer"
        },
        "widget": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "title": "Widget",
          "type": "string"
        },
        "x": {
          "exclusiveMaximum": 12,
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "widget",
        "x",
        "y",
        "w",
        "h"
      ],
      "title": "LayoutItem",
      "type": "object"
    },
    "Measure": {
      "additionalProperties": false,
      "description": "A named measure. ``expr`` must parse in the measure grammar; it is never SQL.",
      "properties": {
        "expr": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Expr",
          "type": "string"
        },
        "format": {
          "anyOf": [
            {
              "enum": [
                "number",
                "percent",
                "duration_ms",
                "bytes",
                "rate"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format"
        },
        "id": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        }
      },
      "required": [
        "id",
        "expr"
      ],
      "title": "Measure",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "decision_ids": {
          "items": {
            "type": "string"
          },
          "title": "Decision Ids",
          "type": "array"
        },
        "option_id": {
          "title": "Option Id",
          "type": "string"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        }
      },
      "required": [
        "option_id"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "RangeFilter": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "gte": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gte"
        },
        "lte": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lte"
        },
        "op": {
          "const": "range",
          "default": "range",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "field"
      ],
      "title": "RangeFilter",
      "type": "object"
    },
    "RelativeTimeFilter": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "default": "data_max",
          "enum": [
            "data_max",
            "now"
          ],
          "title": "Anchor",
          "type": "string"
        },
        "field": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "last": {
          "exclusiveMinimum": 0,
          "title": "Last",
          "type": "integer"
        },
        "op": {
          "const": "relative_time",
          "default": "relative_time",
          "title": "Op",
          "type": "string"
        },
        "unit": {
          "enum": [
            "minute",
            "hour",
            "day",
            "week"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "field",
        "last",
        "unit"
      ],
      "title": "RelativeTimeFilter",
      "type": "object"
    },
    "SemanticQuery": {
      "additionalProperties": false,
      "description": "What to compute. ``measures`` are ids resolved against a measure catalog.",
      "properties": {
        "dataset": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "title": "Dataset",
          "type": "string"
        },
        "dimensions": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Dimensions",
          "type": "array"
        },
        "filters": {
          "items": {
            "discriminator": {
              "mapping": {
                "eq": "#/$defs/EqFilter",
                "in": "#/$defs/InFilter",
                "last_n": "#/$defs/LastNFilter",
                "range": "#/$defs/RangeFilter",
                "relative_time": "#/$defs/RelativeTimeFilter"
              },
              "propertyName": "op"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/EqFilter"
              },
              {
                "$ref": "#/$defs/InFilter"
              },
              {
                "$ref": "#/$defs/RangeFilter"
              },
              {
                "$ref": "#/$defs/RelativeTimeFilter"
              },
              {
                "$ref": "#/$defs/LastNFilter"
              }
            ]
          },
          "title": "Filters",
          "type": "array"
        },
        "limit": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        },
        "measures": {
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
            "type": "string"
          },
          "title": "Measures",
          "type": "array"
        },
        "sort": {
          "items": {
            "$ref": "#/$defs/SortKey"
          },
          "title": "Sort",
          "type": "array"
        },
        "time_grain": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeGrain"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "top_n": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top N"
        }
      },
      "required": [
        "dataset"
      ],
      "title": "SemanticQuery",
      "type": "object"
    },
    "SortKey": {
      "additionalProperties": false,
      "properties": {
        "dir": {
          "default": "asc",
          "enum": [
            "asc",
            "desc"
          ],
          "title": "Dir",
          "type": "string"
        },
        "field": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        }
      },
      "required": [
        "field"
      ],
      "title": "SortKey",
      "type": "object"
    },
    "Threshold": {
      "additionalProperties": false,
      "properties": {
        "above": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Above"
        },
        "below": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Below"
        },
        "color": {
          "enum": [
            "good",
            "warning",
            "critical"
          ],
          "title": "Color",
          "type": "string"
        }
      },
      "required": [
        "color"
      ],
      "title": "Threshold",
      "type": "object"
    },
    "TimeGrain": {
      "enum": [
        "minute",
        "hour",
        "day",
        "week",
        "build"
      ],
      "title": "TimeGrain",
      "type": "string"
    },
    "Widget": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "items": {
            "$ref": "#/$defs/Annotation"
          },
          "title": "Annotations",
          "type": "array"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "encoding": {
          "anyOf": [
            {
              "$ref": "#/$defs/Encoding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "options": {
          "anyOf": [
            {
              "$ref": "#/$defs/WidgetOptions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "query": {
          "$ref": "#/$defs/SemanticQuery"
        },
        "target": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "thresholds": {
          "items": {
            "$ref": "#/$defs/Threshold"
          },
          "title": "Thresholds",
          "type": "array"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/WidgetType"
        }
      },
      "required": [
        "id",
        "type",
        "title",
        "query"
      ],
      "title": "Widget",
      "type": "object"
    },
    "WidgetOptions": {
      "additionalProperties": false,
      "properties": {
        "bins": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 500,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bins"
        },
        "horizontal": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Horizontal"
        },
        "log_scale": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Log Scale"
        },
        "show_other": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Show Other"
        },
        "sparkline": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sparkline"
        },
        "stack": {
          "anyOf": [
            {
              "enum": [
                "none",
                "stacked",
                "percent"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stack"
        }
      },
      "title": "WidgetOptions",
      "type": "object"
    },
    "WidgetType": {
      "enum": [
        "kpi",
        "line",
        "area",
        "bar",
        "stacked_bar",
        "donut",
        "histogram",
        "box",
        "scatter",
        "heatmap",
        "pareto",
        "table"
      ],
      "title": "WidgetType",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Spec body. The version number lives on DashboardVersion, not here.",
  "properties": {
    "dashboard_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Dashboard Id",
      "type": "string"
    },
    "datasets": {
      "items": {
        "$ref": "#/$defs/DatasetBinding"
      },
      "minItems": 1,
      "title": "Datasets",
      "type": "array"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "filters": {
      "items": {
        "$ref": "#/$defs/GlobalFilter"
      },
      "title": "Filters",
      "type": "array"
    },
    "layout": {
      "$ref": "#/$defs/Layout"
    },
    "measures": {
      "items": {
        "$ref": "#/$defs/Measure"
      },
      "title": "Measures",
      "type": "array"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "widgets": {
      "items": {
        "$ref": "#/$defs/Widget"
      },
      "title": "Widgets",
      "type": "array"
    }
  },
  "required": [
    "dashboard_id",
    "title",
    "datasets"
  ],
  "title": "DashboardSpec",
  "type": "object"
}
