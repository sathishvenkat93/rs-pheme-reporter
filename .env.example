# Copy to .env. Every Pheme setting is listed here with its default.

PHEME_ENV=dev
PHEME_LOG_LEVEL=INFO

# Postgres, Redis and the S3-compatible store from docker-compose.yml
PHEME_DATABASE_URL=postgresql+psycopg://pheme:pheme@localhost:5432/pheme
PHEME_REDIS_URL=redis://localhost:6379/0
PHEME_S3_ENDPOINT=localhost:8333
PHEME_S3_ACCESS_KEY=pheme
PHEME_S3_SECRET_KEY=pheme-secret
PHEME_S3_BUCKET=pheme
PHEME_S3_SECURE=false

# Host ports used by docker-compose.yml
PHEME_PG_PORT=5432
PHEME_REDIS_PORT=6379
PHEME_S3_PORT=8333

# Ingestion
PHEME_MAX_UPLOAD_BYTES=209715200
PHEME_DEFAULT_TIMEZONE=UTC
PHEME_LOCAL_CACHE_DIR=/tmp/pheme-cache
PHEME_QUEUE_NAME=pheme

# Query service
PHEME_QUERY_TIMEOUT_S=30
PHEME_QUERY_ROW_CAP=10000
PHEME_QUERY_CACHE_TTL_S=86400

# Dev identity (replaced by real auth in M12)
PHEME_DEV_USER_ID=00000000-0000-0000-0000-000000000001
PHEME_DEV_WORKSPACE_ID=00000000-0000-0000-0000-0000000000a1

# LLM (used from M8). Never commit a real key.
PHEME_ANTHROPIC_API_KEY=
PHEME_MODEL_MAIN=claude-sonnet-5-5
PHEME_MODEL_FAST=claude-haiku-5-5
PHEME_LIVE_LLM=false
