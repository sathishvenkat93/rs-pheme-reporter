# Copy to .env. Every Pheme setting is listed here with its default.

PHEME_ENV=dev
PHEME_LOG_LEVEL=INFO

# Postgres, Redis and the S3-compatible store from docker-compose.yml
# The app connects as pheme_app (row-level security applies); migrations run as the owner.
PHEME_DATABASE_URL=postgresql+psycopg://pheme_app:pheme_app@localhost:5432/pheme
PHEME_MIGRATION_DATABASE_URL=postgresql+psycopg://pheme:pheme@localhost:5432/pheme
PHEME_APP_DB_PASSWORD=pheme_app
PHEME_REDIS_URL=redis://localhost:6379/0
PHEME_S3_ENDPOINT=localhost:8333
PHEME_S3_ACCESS_KEY=pheme
PHEME_S3_SECRET_KEY=pheme-secret
PHEME_S3_BUCKET=pheme
PHEME_S3_SECURE=false

# Host ports used by docker-compose.yml
PHEME_PG_PORT=5432
PHEME_REDIS_PORT=6379
PHEME_S3_PORT=8333

# Ingestion
PHEME_MAX_UPLOAD_BYTES=209715200
PHEME_DEFAULT_TIMEZONE=UTC
PHEME_LOCAL_CACHE_DIR=/tmp/pheme-cache
PHEME_QUEUE_NAME=pheme

# Query service
PHEME_QUERY_TIMEOUT_S=30
PHEME_QUERY_ROW_CAP=10000
PHEME_QUERY_CACHE_TTL_S=86400

# Recommendation scoring weights (R4), as JSON
PHEME_RECOMMEND_WEIGHTS={"data_fit": 0.30, "intent": 0.25, "insight": 0.20, "perception": 0.15, "domain_prior": 0.10, "redundancy": 1.0, "clutter": 1.0}

# Auth: none (fixed dev user, never in production) | dev (email login) | oidc
PHEME_AUTH_MODE=none
PHEME_SECRET_KEY=dev-only-secret-change-me-in-production-0000
PHEME_SESSION_TTL_S=604800
PHEME_OIDC_ISSUER=
PHEME_OIDC_AUDIENCE=
PHEME_OIDC_WORKSPACE_CLAIM=

# Dev identity used when PHEME_AUTH_MODE=none
PHEME_DEV_USER_ID=00000000-0000-0000-0000-000000000001
PHEME_DEV_WORKSPACE_ID=00000000-0000-0000-0000-0000000000a1

# LLM (used from M8). Never commit a real key.
# PHEME_LLM=fake runs offline with scripted answers; set anthropic to use the real models.
PHEME_LLM=fake
PHEME_ANTHROPIC_API_KEY=
PHEME_MODEL_MAIN=claude-sonnet-5-5
PHEME_MODEL_FAST=claude-haiku-5-5
PHEME_LIVE_LLM=false
